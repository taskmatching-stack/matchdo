# Supabase REST（給應用使用）
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-anon-or-service-key>

# Gemini（首頁 AI 識別、分析等）
GEMINI_API_KEY=<your-gemini-api-key>

# Replicate（AI 放大 Real-ESRGAN；取代 Stability Fast Upscale）
# 正式／Cloud Run 也須設定同名變數；勿把真實 token 寫進版控
REPLICATE_API_TOKEN=<your-replicate-api-token>
# REPLICATE_ACCOUNT_LABEL=matchdo

# BFL / FLUX 2.0 pro（產品設計 AI 生圖，POST https://api.bfl.ai/v1/flux-2-pro）
BFL_API_KEY=<your-bfl-api-key>

# 服務媒合（發包／專案／媒合）：設為 false 則前台隱藏相關入口；true 或未設則顯示
# ENABLE_SERVICE_MATCHING=false

# Supabase Postgres 連線字串（給建表腳本使用）
# 直連：port 5432；若顯示 Not IPv4 compatible，改用 Session Pooler：port 6543
# 例：postgresql://postgres:<YOUR_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# 例（Pooler）：postgresql://postgres:<YOUR_PASSWORD>@db.<project-ref>.supabase.co:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres:<YOUR_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# 對外公開網址（SEO sitemap／robots、付款回調）。正式站請用 https://matchdo.cc
# 勿設成 *.run.app；若誤設，程式會自動改用 https://matchdo.cc
BASE_URL=http://localhost:3000
# 可選：明確覆寫對外網域（優先於 BASE_URL）
# PUBLIC_SITE_URL=https://matchdo.cc
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 正式環境時改為 1，並使用正式 MerchantID / HashKey / HashIV
# ECPAY_USE_PRODUCTION=0
